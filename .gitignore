# ============================================================
# .gitignore — Meta App
# ============================================================

# Variáveis de ambiente (NUNCA commitar — contém senhas e SECRET_KEY)
.env
.env.*
# Templates sem segredo: o "!" precisa ser explicito por arquivo, senao o
# padrao .env.* acima os engole.
!.env.example
!.env.production.example
!.env.local.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python

# Virtualenv
venv/
env/
.venv/
ENV/

# Alembic — não versionar o arquivo de config local
# (alembic.ini pode ser commitado, mas não versões de migração geradas localmente se necessário)

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Configuração local de ferramentas (launch.json guarda caminho absoluto
# da máquina de quem criou — não serve para mais ninguém)
.claude/

# Node — o único lockfile válido é frontend/meta-app/package-lock.json.
# Um npm install rodado na pasta errada cria stubs vazios na raiz e em
# frontend/, e lockfile vazio faz o Next inferir o workspace root errado.
/package-lock.json
/frontend/package-lock.json
node_modules/
.next/

# Logs
*.log
logs/

# Uploads / arquivos gerados em runtime
uploads/

# Cobertura de testes
.coverage
htmlcov/
.pytest_cache/

# Distribuição / build Python
dist/
build/
*.egg-info/
