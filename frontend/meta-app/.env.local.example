# ==========================================================
# MetaAPP Frontend — Variáveis de Ambiente (LOCAL / DEV)
# Copie este arquivo como .env.local e ajuste os valores.
#
# Para desenvolvimento local: deixe o valor padrão abaixo.
# Para produção (VPS): aponte para a URL real do backend.
# ==========================================================

# URL base da API do backend (sem barra final)
# Desenvolvimento:
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Produção (EasyPanel):
# NEXT_PUBLIC_API_URL=https://banco-de-dados-metaapp-backend.d86ysa.easypanel.host/api/v1
