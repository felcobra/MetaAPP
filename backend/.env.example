# ============================================================
# Meta App — Template de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com valores reais
# NUNCA commite o arquivo .env no repositório!
# ============================================================

# ---- Ambiente ----
# Em produção: DEBUG=false
DEBUG=true

# ---- Segurança JWT ----
# OBRIGATÓRIO em produção — gere com: openssl rand -hex 32
SECRET_KEY=mude-esta-chave-em-producao-use-openssl-rand-hex-32

# ---- Banco de Dados MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=metaapp_user
DB_PASSWORD=sua_senha_aqui
DB_NAME=metaapp

# ---- CORS — URLs do frontend permitidas ----
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7
