# ============================================================
# Meta App — Backend em PRODUÇÃO (rodando na VPS)
# Copie para .env NA VPS e preencha. NUNCA commite o .env real.
# ============================================================

# ---- Ambiente ----
# false ativa as validações de segurança do config.py
DEBUG=false

# ---- Segurança JWT ----
# OBRIGATÓRIO: gere na VPS com  openssl rand -hex 32
# Chave < 32 chars ou a padrão fazem o boot falhar quando DEBUG=false.
SECRET_KEY=

# ---- Banco de Dados MySQL ----
# DB_HOST é o nome do container do banco: serviços do mesmo projeto EasyPanel
# se enxergam pela rede interna. Nada é exposto na internet.
DB_HOST=banco_de_dados_bd
DB_PORT=3306
DB_USER=meta
DB_PASSWORD=
DB_NAME=banco_de_dados

# ---- CORS ----
# Domínio(s) de onde o frontend é servido em produção.
ALLOWED_ORIGINS=["https://app.metaconsultoria.com"]

# ---- E-mail (redefinicao de senha) ----
# Microsoft 365: smtp.office365.com na porta 587 (STARTTLS). Exige que o
# SMTP AUTH esteja habilitado na caixa pelo admin do tenant -- a Microsoft
# desabilita por padrao. Se estiver bloqueado, aponte para outro provedor:
# o codigo so fala SMTP, nao depende de quem esta do outro lado.
# Deixar vazio desliga o envio; /auth/forgot-password continua respondendo
# igual (para nao revelar quais e-mails existem) e registra um aviso no log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Base dos links enviados por e-mail. Aponta para o FRONTEND, nao para a API.
# IMPORTANTE: coloque aqui o domínio real do frontend em produção, ex:
# FRONTEND_URL=https://app.metaconsultoria.com
FRONTEND_URL=https://app.metaconsultoria.com
RESET_TOKEN_EXPIRE_MINUTES=30

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
