# ============================================================
# Meta App — Backend em PRODUÇÃO (rodando na VPS)
# Copie para .env NA VPS e preencha. NUNCA commite o .env real.
# ============================================================

# ---- Ambiente ----
# false ativa as validações de segurança do config.py
DEBUG=false

# ---- Segurança JWT ----
# OBRIGATÓRIO: gere na VPS com  openssl rand -hex 32
# Chave < 32 chars ou a padrão fazem o boot falhar quando DEBUG=false.
SECRET_KEY=

# ---- Banco de Dados MySQL ----
# O backend roda na mesma rede Docker do banco, então DB_HOST é o nome do
# container (confirmado no dump: "Host: banco_de_dados_bd"), não um IP.
# Nada é exposto na internet — a porta 3306 continua fechada no firewall.
DB_HOST=banco_de_dados_bd
DB_PORT=3306
# NÃO use root. Crie um usuário dedicado (ver README de deploy).
DB_USER=metaapp_user
DB_PASSWORD=
# Nome do schema real da empresa (dump: "Database: banco_de_dados").
DB_NAME=banco_de_dados

# ---- CORS ----
# Domínio(s) de onde o frontend é servido em produção.
ALLOWED_ORIGINS=["https://app.metaconsultoria.com"]

# ---- Tokens ----
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
